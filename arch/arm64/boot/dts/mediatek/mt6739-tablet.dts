/dts-v1/;

#include "mt6739.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/mt65xx.h>

/ {
    model = "Generic MT6739 Tablet";
    compatible = "generic,mt6739-tablet", "mediatek,mt6739";

    aliases {
        serial0 = &uart0;
        mmc0 = &mmc0;
        mmc1 = &mmc1;
    };

    chosen {
        stdout-path = "serial0:115200n8";
    };

    memory@40000000 {
        device_type = "memory";
        reg = <0 0x40000000 0 0x40000000>; /* 1GB RAM */
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        /* Reserve 16MB at the end for firmware */
        firmware@7f000000 {
            reg = <0 0x7f000000 0 0x01000000>;
            no-map;
        };
    };

    gpio-keys {
        compatible = "gpio-keys";

        power {
            label = "Power";
            gpios = <&pio 8 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_POWER>;
            wakeup-source;
        };

        volume-up {
            label = "Volume Up";
            gpios = <&pio 9 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_VOLUMEUP>;
        };

        volume-down {
            label = "Volume Down";
            gpios = <&pio 10 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_VOLUMEDOWN>;
        };
    };

    fixed_clks: fixed-clocks {
        compatible = "simple-bus";
        #address-cells = <1>;
        #size-cells = <0>;

        clk26m: oscillator-26000000hz {
            compatible = "fixed-clock";
            #clock-cells = <0>;
            clock-frequency = <26000000>;
            clock-output-names = "clk26m";
        };
    };
};

&pio {
    uart0_pins: uart0-pins {
        pins_tx_rx {
            pinmux = <PINMUX_GPIO20__FUNC_UART0TX>,
                     <PINMUX_GPIO21__FUNC_UART0RX>;
        };
    };

    mmc0_pins_default: mmc0-default-pins {
        pins_cmd_clk_dat_rst {
            pinmux = <PINMUX_GPIO38__FUNC_MSDC0_CMD>,
                     <PINMUX_GPIO39__FUNC_MSDC0_DSL>,
                     <PINMUX_GPIO40__FUNC_MSDC0_CLK>,
                     <PINMUX_GPIO41__FUNC_MSDC0_DAT0>,
                     <PINMUX_GPIO42__FUNC_MSDC0_DAT1>,
                     <PINMUX_GPIO43__FUNC_MSDC0_DAT2>,
                     <PINMUX_GPIO44__FUNC_MSDC0_DAT3>,
                     <PINMUX_GPIO45__FUNC_MSDC0_DAT4>,
                     <PINMUX_GPIO46__FUNC_MSDC0_DAT5>,
                     <PINMUX_GPIO47__FUNC_MSDC0_DAT6>,
                     <PINMUX_GPIO48__FUNC_MSDC0_DAT7>,
                     <PINMUX_GPIO49__FUNC_MSDC0_RSTB>;
            input-enable;
            drive-strength = <MTK_DRIVE_6mA>;
            bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
        };
    };

    mmc1_pins_default: mmc1-default-pins {
        pins_cmd_clk_dat {
            pinmux = <PINMUX_GPIO71__FUNC_MSDC1_CMD>,
                     <PINMUX_GPIO72__FUNC_MSDC1_CLK>,
                     <PINMUX_GPIO73__FUNC_MSDC1_DAT0>,
                     <PINMUX_GPIO74__FUNC_MSDC1_DAT1>,
                     <PINMUX_GPIO75__FUNC_MSDC1_DAT2>,
                     <PINMUX_GPIO76__FUNC_MSDC1_DAT3>;
            input-enable;
            drive-strength = <MTK_DRIVE_6mA>;
            bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
        };
    };
};

&uart0 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart0_pins>;
    status = "okay";
};

&mmc0 {
    pinctrl-names = "default";
    pinctrl-0 = <&mmc0_pins_default>;
    bus-width = <8>;
    max-frequency = <200000000>;
    cap-mmc-highspeed;
    mmc-hs200-1_8v;
    cap-mmc-hw-reset;
    non-removable;
    status = "okay";
};

&mmc1 {
    pinctrl-names = "default";
    pinctrl-0 = <&mmc1_pins_default>;
    bus-width = <4>;
    max-frequency = <200000000>;
    cap-sd-highspeed;
    sd-uhs-sdr104;
    cd-gpios = <&pio 5 GPIO_ACTIVE_LOW>;
    status = "okay";
};

&usb2 {
    status = "okay";
};

&usb2phy {
    status = "okay";
};

/* Enable topckgen, infracfg, pericfg clocks */
&topckgen {
    status = "okay";
};

&infracfg {
    status = "okay";
};

&pericfg {
    status = "okay";
};